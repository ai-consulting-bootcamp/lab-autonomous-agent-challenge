      "id": "bac0f745-7d55-4f9f-9f41-135e4e47b7e1",
      "name": "Guard to review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2320,
        48
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Same checks as the Python app: private seller rule + score must match breakdown and thresholds\nconst o = $json.output;\nconst b = o.score_breakdown || {};\nconst ratingFor = s => (s >= 70 ? 'Hot' : s >= 40 ? 'Warm' : 'Cold');\nconst sum = () => Object.values(b).reduce((a, v) => a + Number(v || 0), 0);\n\nif (o.sales_team === 'None (self-service)' && o.rating !== 'Needs review') {\n  b.category = 0; b.volume = 0; b.need = 0;\n  o.lead_score = sum();\n  o.rating = ratingFor(o.lead_score);\n  o.score_reason += ' [Private seller rule applied in code]';\n}\n\nconst total = sum();\nif (o.rating !== 'Needs review' && (total !== o.lead_score || o.rating !== ratingFor(total))) {\n  o.score_reason += ` [Check failed: breakdown sum ${total}, score ${o.lead_score}, rating ${o.rating}]`;\n  o.rating = 'Needs review';\n  o.sales_team = 'Sales manager';\n}\n\nreturn { json: { ...$json, output: o } };"
      },
      "id": "6d306728-08be-40dd-8148-46719e0bcd3f",
      "name": "Score check",
      "type": "n8n-nodes-base.code",
