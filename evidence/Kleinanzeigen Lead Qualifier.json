              "name": "output",
              "value": "={{ { rating: 'Needs review', lead_score: 0, sales_team: 'Sales manager', score_reason: 'Input guard: inquiry empty, too long or contains instructions to the AI. No LLM call.', drafted_reply: '', kb_sources: [] } }}",
